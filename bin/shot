#!/usr/bin/env bash
# Render typo offscreen and save a screenshot, for checking the UI without a
# display: bin/shot OUT.png [file] [--size=WxH] [--sidebar[=outline|list|tree]] [--cursor=ROW:POS]
# [--menu=N]. Settings go to a throwaway directory, not ~/.config/typo.
set -euo pipefail
cd "$(dirname "$0")/.."
out=$(realpath -m "$1")
shift
cargo build --quiet 2>&1 | grep -v "^warning: typo@[^:]*:" | grep -E "^error" -A8 || true
config=$(mktemp -d)
trap 'rm -rf "$config"' EXIT
XDG_CONFIG_HOME=$config XDG_DATA_HOME=$config/data QT_QPA_PLATFORM=offscreen QT_FORCE_STDERR_LOGGING=1 \
    timeout 60 target/debug/typo "$@" --size=1400x900 --screenshot="$out"
