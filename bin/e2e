#!/usr/bin/env bash
# Run the end-to-end scripts in tests/e2e (see its README):
# bin/e2e [--update] [NAME…]
set -euo pipefail
cd "$(dirname "$0")/.."
update=0
if [ "${1:-}" = --update ]; then
    update=1
    shift
fi
cargo build --quiet 2>&1 | grep -v "^warning: typo@0.1.0:" | grep -E "^error" -A8 || true
# The real path: the Mac's temp folder is behind the /var symlink.
work=$(cd "$(mktemp -d)" && pwd -P)
# KEEP=1 keeps the logs and screenshots, and says where.
if [ -n "${KEEP:-}" ]; then echo "work: $work"; else trap 'rm -rf "$work"' EXIT; fi
names=("$@")
if [ ${#names[@]} -eq 0 ]; then
    for f in tests/e2e/*.script; do names+=("$(basename "$f" .script)"); done
fi
failed=0
for name in "${names[@]}"; do
    # Each test has a folder of its own, settings and all, so what one
    # leaves behind can't change another. The data folder holds the
    # trash; Qt won't trash a file without it.
    dir=$work/$name
    mkdir -p "$dir/data"
    out=$dir/$name.md
    sed "s|@OUT@|$out|g; s|@SHOT@|$dir/$name.png|g; s|@DIR@|$dir|g; s|@REPO@|$PWD|g" "tests/e2e/$name.script" > "$dir/$name.script"
    # perl's alarm stands in for timeout(1), which macOS doesn't have.
    XDG_CONFIG_HOME=$dir/config XDG_DATA_HOME=$dir/data QT_QPA_PLATFORM=offscreen QT_FORCE_STDERR_LOGGING=1 \
        perl -e 'alarm 60; exec @ARGV' target/debug/typo --size=1200x800 --cursor=0:0 --script="$dir/$name.script" \
        > "$dir/$name.log" 2>&1 || true
    # A pasted picture is named for the time it was pasted.
    [ -f "$out" ] && perl -pi -e 's/image-[0-9]{17}/image-STAMP/g' "$out"
    if [ ! -f "$out" ]; then
        echo "FAIL $name: no output"
        sed 's/^/    /' "$dir/$name.log"
        failed=1
    elif grep -q "^qrc:\|^file:\|script:" "$dir/$name.log"; then
        # A QML warning or a bad script step fails the test too.
        echo "FAIL $name: warnings"
        grep "^qrc:\|^file:\|script:" "$dir/$name.log" | sed 's/^/    /'
        failed=1
    elif [ $update = 1 ]; then
        cp "$out" "tests/e2e/$name.md"
        echo "updated $name"
    elif diff -u "tests/e2e/$name.md" "$out" > "$dir/$name.diff"; then
        echo "ok   $name"
    else
        echo "FAIL $name"
        sed 's/^/    /' "$dir/$name.diff"
        grep -v "^qt\.\|^$" "$dir/$name.log" | sed 's/^/    log: /' || true
        failed=1
    fi
done
exit $failed
