# Preferences ▸ Markdown ▸ Code Fences ▸ "Use Shift+Tab to auto indent
# selected code": Shift+Tab gives the caret's line, or the selected
# lines, the indent of the line above (as CodeMirror's indentAuto), not
# an outdent; selected blank lines lose their spaces. Off, it outdents.
eval Prefs.shiftTabAutoIndent = true
write @DIR@/doc.md ```\nif x {\n    y();\nz();\n  w();\n   \nv();\n}\n```\n
cmd openPath @DIR@/doc.md
wait 100
caret 0 16
key Shift+Tab
check view.editAt(0).text.split("\n")[2] === "    z();" && view.editAt(0).cursorPosition === 20
key Down Shift+Down Shift+Down
key Shift+Tab
check view.editAt(0).text.split("\n").slice(3, 6).join("|") === "    w();||v();"
eval Prefs.shiftTabAutoIndent = false
key Ctrl+Home
key Down
key Shift+Tab
check view.editAt(0).text.split("\n")[1] === "y();"
dump @OUT@
